APP_NAME=BranchBank25
APP_PORT=8081
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://bank:bank@postgres:5432/branchbank
USER_JWT_SECRET=change-me-user-secret
USER_JWT_TTL_MINUTES=120
CENTRAL_BANK_BASE_URL=https://test.diarainfra.com/central-bank/api/v1
BANK_NAME=OLL001
BANK_PUBLIC_URL=http://localhost:8081
BANK_PREFIX=OLL
BANK_REGISTRATION_ID=
SUPPORTED_CURRENCIES=EUR,USD,GBP,SEK
KEYS_DIR=./keys
# Must be <= 1800 (30 minutes) to keep bank registration active.
HEARTBEAT_INTERVAL_SECONDS=900
BANK_SYNC_INTERVAL_SECONDS=300
PENDING_RETRY_POLL_SECONDS=30
PENDING_TIMEOUT_HOURS=4
